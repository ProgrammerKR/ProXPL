use std.native.path;
use std.native.process;
use std.native.buffer;

println("Testing Path module...");
println("  dirname: " + path.dirname("a/b/c.txt"));
println("  basename: " + path.basename("a/b/c.txt"));
println("  exists: " + to_string(path.exists("compile.bat")));

println("Testing Process module...");
println("  cwd: " + process.cwd());
println("  pid: " + to_string(process.pid()));

println("Testing Buffer module...");
let b = buffer.alloc(10);
buffer.write_byte(b, 72); // H
buffer.write_byte(b, 101); // e
buffer.write_byte(b, 108); // l
buffer.write_byte(b, 108); // l
buffer.write_byte(b, 111); // o
println("  hex_dump: " + buffer.hex_dump(b));
println("  to_string: " + buffer.to_string(b));
