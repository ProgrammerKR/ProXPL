// ProXPL Concurrency Core Tests
// Verify Lexer and Parser can parse these new constructs without error.

actor Worker {
    let id: int;
    
    receive(msg: any) {
        print("Worker received: " + str(msg));
    }
}

func testConcurrencySyntax() {
    let worker = Worker();
    
    // Test comptime expression
    let c = comptime {
        return 42;
    };
    print("Comptime value: " + str(c));
    
    // Test Actor communication syntax
    worker ! "Hello, Worker!";
    let response = worker ? "Status?";
    
    // Test channels
    // let ch = channel;
}

testConcurrencySyntax();
