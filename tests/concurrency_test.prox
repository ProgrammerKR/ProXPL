// ProXPL Concurrency Core Tests
// Verify Lexer and Parser can parse these new constructs without error.

// Stub actor for testing
class Worker {
    let id;

    func init() {
        this.id = 0;
    }

    func receive(msg) {
        print("Worker received: " + to_string(msg));
    }
}

func testConcurrencySyntax() {
    let worker = Worker();

    // Test comptime expression
    let c = comptime {
        return 42;
    };
    print("Comptime value: " + to_string(c));

    print("Concurrency syntax test completed.");
}

testConcurrencySyntax();
