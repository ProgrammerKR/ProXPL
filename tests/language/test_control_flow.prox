// Test Control Flow
use std.core;

print("--- Testing Control Flow ---");

func assert(condition, message) {
    if (condition) {
        print("PASS: " + message);
    } else {
        print("FAIL: " + message);
    }
}

// 1. If-Else
let a = 10;
let if_result = "";
if (a > 5) {
    if_result = "greater";
} else {
    if_result = "smaller";
}
assert(if_result == "greater", "If condition");

if (a < 5) {
    if_result = "smaller";
} else {
    if_result = "greater_or_eq";
}
assert(if_result == "greater_or_eq", "Else condition");

// 2. While loop
let i = 0;
let sum = 0;
while (i < 5) {
    sum = sum + i;
    i = i + 1;
}
assert(sum == 10, "While loop summation");
assert(i == 5, "While loop exit condition");

// 3. For loop
let for_sum = 0;
for (let j = 0; j < 5; j = j + 1) {
    for_sum = for_sum + j;
}
assert(for_sum == 10, "For loop summation");

print("Control Flow Tests Completed");
